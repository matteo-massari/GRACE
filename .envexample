# Shared project configuration.

# Neo4j (used by graph-rag-agent and pipeline)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
# If you change NEO4J_BOLT_PORT, also update NEO4J_URI.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Graph RAG agent (CLI). Reserved ports: these do not start a web server.
AGENT_SERVER_PORT=8000
CHAINLIT_CLIENT_PORT=3546
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# GOOGLE_API_KEY=

# MLflow in Docker: database and artifacts are stored in the mlflow_data volume.
# MLFLOW_PORT is the host port; the container always uses port 5000.
MLFLOW_PORT=1234
MLFLOW_TRACKING_URI=http://127.0.0.1:1234
MLFLOW_EXPERIMENT=graph-recommendation-demo

# For a remote instance:
# MLFLOW_EXPERIMENT=project
# MLFLOW_TRACKING_USERNAME=experiment
# MLFLOW_TRACKING_PASSWORD=password
# MLFLOW_TRACKING_URI=https://mlflow-instance
# MLFLOW_TRACKING_INSECURE_TLS=true

# Path to the data
DATA_PATH=database/gnn
