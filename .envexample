# Configurazione condivisa del progetto.

# Neo4j (usato da graph-rag-agent e pipeline)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Graph RAG agent
AGENT_SERVER_PORT=8000
CHAINLIT_CLIENT_PORT=3546
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# GOOGLE_API_KEY=

# Per utilizzare un'istanza di MLflow in locale, definire le seguenti variabili
# per graph-neural-network:
# - MLFLOW_BACKEND_URI: backend store dei metadati MLflow
# - MLFLOW_ARTIFACT_ROOT: directory dove salvare gli artifact
# - MLFLOW_HOST: host su cui esporre il server MLflow
# - MLFLOW_PORT: porta del server MLflow

MLFLOW_BACKEND_URI=sqlite:////path/mlflow.db
MLFLOW_ARTIFACT_ROOT=file:///path/artifacts
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=1234

# Se l'istanza e' locale:
MLFLOW_TRACKING_URI=http://0.0.0.0:1234
MLFLOW_EXPERIMENT=Nome Esperimento

# Se l'istanza non e' locale:
# MLFLOW_EXPERIMENT=progetto
# MLFLOW_TRACKING_USERNAME=esperimento
# MLFLOW_TRACKING_PASSWORD=password
# MLFLOW_TRACKING_URI=https://istanza-mlflow
# MLFLOW_TRACKING_INSECURE_TLS=true

# Indicare dove si trovano i dati
DATA_PATH=/path
